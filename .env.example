# Formspree endpoint for every enquiry form (training, hire talent, join network).
# Create a form at https://formspree.io, then copy its endpoint URL here.
# Until this is set, forms fall back to opening the visitor's email client.
# Each submission includes a form_type field so you can tell them apart.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Canonical origin for social previews, sitemap.xml and robots.txt.
# Leave blank on Vercel: it is derived from the project's production domain and
# updates itself when a custom domain is added. Set it only when building for a
# non-Vercel host, e.g. https://www.skilledgetechsolutions.com
NEXT_PUBLIC_SITE_URL=
